\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Controlled readout comparisons by paired bootstrap over targets. Changing the readout of a fixed AlphaFold2 model from confidence to geometry helps significantly everywhere; changing the folding model while keeping the confidence readout does not help at all.\relax }}{10}{table.caption.11}\protected@file@percent }
\newlabel{tab:readout}{{7}{10}{Controlled readout comparisons by paired bootstrap over targets. Changing the readout of a fixed AlphaFold2 model from confidence to geometry helps significantly everywhere; changing the folding model while keeping the confidence readout does not help at all.\relax }{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The conflation mechanism. {\em  (a)}Reading solvent accessibility instead of confidence out of the same AlphaFold2 coordinates improves AUC on all four reference sets, while replacing AlphaFold2 with AlphaFold3 does not. {\em  (b)}Within \textsc  {pLDDT}\xspace  strata, \textsc  {pLDDT}\xspace  has saturated --- inside its own $<$50 band it discriminates disorder at chance level on the \textsc  {Disorder-NOX}\xspace  references --- while the geometry of the same model still separates disorder from order.\relax }}{10}{figure.caption.12}\protected@file@percent }
\newlabel{fig:mech}{{4}{10}{The conflation mechanism. \captiona Reading solvent accessibility instead of confidence out of the same AlphaFold2 coordinates improves AUC on all four reference sets, while replacing AlphaFold2 with AlphaFold3 does not. \captionb Within \plddt strata, \plddt has saturated --- inside its own $<$50 band it discriminates disorder at chance level on the \dnox references --- while the geometry of the same model still separates disorder from order.\relax }{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Comparison with prior work}{10}{subsection.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Structural profile of the rule's error strata (2026 \textsc  {AlphaFold DB}\xspace  snapshot, Shrake--Rupley RSA). ``\% buried'' is the fraction with RSA $<$ 0.25. The disorder the rule misses is not borderline: it is confidently modelled and mostly solvent-exposed, i.e.,\xspace  extended pseudostructure rather than genuinely ambiguous prediction.\relax }}{11}{table.caption.13}\protected@file@percent }
\newlabel{tab:errorstrata}{{8}{11}{Structural profile of the rule's error strata (2026 \afdb snapshot, Shrake--Rupley RSA). ``\% buried'' is the fraction with RSA $<$ 0.25. The disorder the rule misses is not borderline: it is confidently modelled and mostly solvent-exposed, \ie extended pseudostructure rather than genuinely ambiguous prediction.\relax }{table.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces What \textsc  {pLDDT}$<$50\xspace  misses. {\em  (a)}Confidence distribution by stratum: false negatives are not clustered just above the cutoff but spread across the confident range. {\em  (b)}Solvent accessibility separates false negatives from true negatives even where confidence does not. {\em  (c)}Amino-acid composition places missed disorder between canonical low-complexity IDRs\xspace  and ordered sequence, consistent with a conformation AlphaFold can commit to.\relax }}{11}{figure.caption.14}\protected@file@percent }
\newlabel{fig:errors}{{5}{11}{What \plddtrule misses. \captiona Confidence distribution by stratum: false negatives are not clustered just above the cutoff but spread across the confident range. \captionb Solvent accessibility separates false negatives from true negatives even where confidence does not. \captionc Amino-acid composition places missed disorder between canonical low-complexity \idrs and ordered sequence, consistent with a conformation AlphaFold can commit to.\relax }{figure.caption.14}{}}
