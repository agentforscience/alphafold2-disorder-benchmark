\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}C1: sensitivity at \textsc  {pLDDT}$<$50\xspace   is 0.6, not 0.8}{5}{subsection.4.1}\protected@file@percent }
\newlabel{sec:c1}{{4.1}{5}{C1: sensitivity at \texorpdfstring {\plddtrule }{pLDDT<50} is 0.6, not 0.8}{subsection.4.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Verdicts on the four clauses. Sensitivity of \textsc  {pLDDT}$<$50\xspace  sits at 0.60--0.63 on every reference set, far below the claimed 0.8 (dashed line), and restricting to regions longer than 30 aa moves it only to 0.63--0.65. Specificity, at the identical operating point, is 0.98 under \textsc  {Disorder-PDB}\xspace  and 0.67--0.76 under \textsc  {Disorder-NOX}\xspace  : the claim ``specificity $<$ 0.7'' is a property of the negative-set convention, not of AlphaFold. Error bars are 95\% bootstrap intervals over targets.\relax }}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:clause}{{1}{6}{Verdicts on the four clauses. Sensitivity of \plddtrule sits at 0.60--0.63 on every reference set, far below the claimed 0.8 (dashed line), and restricting to regions longer than 30 aa moves it only to 0.63--0.65. Specificity, at the identical operating point, is 0.98 under \dpdb and 0.67--0.76 under \dnox : the claim ``specificity $<$ 0.7'' is a property of the negative-set convention, not of AlphaFold. Error bars are 95\% bootstrap intervals over targets.\relax }{figure.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Clause tests for \textsc  {pLDDT}$<$50\xspace  on \textsc  {pLDDT}\xspace  's own target coverage. ``Content'' is the fraction of evaluated residues that are disordered. Specificity 95\% CIs are [0.981, 0.990], [0.618, 0.727], [0.966, 0.989] and [0.696, 0.825] respectively. Sensitivity never approaches 0.8; specificity is decided by the reference convention.\relax }}{6}{table.caption.4}\protected@file@percent }
\newlabel{tab:clause}{{2}{6}{Clause tests for \plddtrule on \plddt 's own target coverage. ``Content'' is the fraction of evaluated residues that are disordered. Specificity 95\% CIs are [0.981, 0.990], [0.618, 0.727], [0.966, 0.989] and [0.696, 0.825] respectively. Sensitivity never approaches 0.8; specificity is decided by the reference convention.\relax }{table.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}C2: specificity is decided by the negative-set convention}{6}{subsection.4.2}\protected@file@percent }
\newlabel{sec:c2}{{4.2}{6}{C2: specificity is decided by the negative-set convention}{subsection.4.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}C4: the short-segment gap is real inside \textsc  {pLDDT}\xspace  , but dedicated predictors do not close it}{6}{subsection.4.3}\protected@file@percent }
\newlabel{sec:c4}{{4.3}{6}{C4: the short-segment gap is real inside \texorpdfstring {\plddt }{pLDDT}, but dedicated predictors do not close it}{subsection.4.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Sensitivity and specificity of a \textsc  {pLDDT}\xspace  cutoff as the cutoff is swept from 5 to 99. The vertical line marks the folk rule at 50. The AlphaFold ``very low confidence'' band was never calibrated against disorder annotations: on all four references the MCC-optimal disorder cutoff falls at \textsc  {pLDDT}\xspace  69--72, and sensitivity 0.80 is not reached until \textsc  {pLDDT}\xspace  68--75.\relax }}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:sweep}{{2}{7}{Sensitivity and specificity of a \plddt cutoff as the cutoff is swept from 5 to 99. The vertical line marks the folk rule at 50. The AlphaFold ``very low confidence'' band was never calibrated against disorder annotations: on all four references the MCC-optimal disorder cutoff falls at \plddt 69--72, and sensitivity 0.80 is not reached until \plddt 68--75.\relax }{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Empirical calibration of the rule. The precision of \textsc  {pLDDT}$<$50\xspace  swings from 0.95 to 0.37 purely with the negative-set convention, while the share of all annotated disorder that falls below \textsc  {pLDDT}\xspace  50 is invariant at 0.60--0.63. Reporting one convention and calling its specificity ``the'' specificity is the single most consequential methodological choice in this literature.\relax }}{7}{table.caption.6}\protected@file@percent }
\newlabel{tab:calibration}{{3}{7}{Empirical calibration of the rule. The precision of \plddtrule swings from 0.95 to 0.37 purely with the negative-set convention, while the share of all annotated disorder that falls below \plddt 50 is invariant at 0.60--0.63. Reporting one convention and calling its specificity ``the'' specificity is the single most consequential methodological choice in this literature.\relax }{table.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Where \textsc  {pLDDT}\xspace   actually stands, fairly compared}{7}{subsection.4.4}\protected@file@percent }
\newlabel{sec:ranking}{{4.4}{7}{Where \texorpdfstring {\plddt }{pLDDT} actually stands, fairly compared}{subsection.4.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}C3: \textsc  {pLDDT}\xspace   is a lossy readout of a structure that already knows better}{7}{subsection.4.5}\protected@file@percent }
\newlabel{sec:c3}{{4.5}{7}{C3: \texorpdfstring {\plddt }{pLDDT} is a lossy readout of a structure that already knows better}{subsection.4.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Region-length-stratified recall of \textsc  {pLDDT}\xspace  with 95\% bootstrap CIs over targets. Short regions are genuinely harder, at both operating points. Calibration raises recall everywhere by 20--35 points at a cost of 3--17 points of specificity, which is why comparing methods at a shared threshold is not a comparison of methods.\relax }}{8}{table.caption.7}\protected@file@percent }
\newlabel{tab:strata}{{4}{8}{Region-length-stratified recall of \plddt with 95\% bootstrap CIs over targets. Short regions are genuinely harder, at both operating points. Calibration raises recall everywhere by 20--35 points at a cost of 3--17 points of specificity, which is why comparing methods at a shared threshold is not a comparison of methods.\relax }{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces The claimed 10--15\% short-segment advantage of dedicated predictors is a calibration artefact. All deltas are percentage points of balanced accuracy on $<$20 aa regions relative to \textsc  {pLDDT}\xspace  ; ``in band'' counts methods landing inside the claimed $+10$ to $+15$\,pp\xspace  window. Left: with every method at its own MCC-optimal threshold, no method is significantly better and the median is worse. Right: cutting every method at 0.5 --- the comparison one gets by thresholding published scores --- reproduces the claim almost exactly on \textsc  {CAID3}\xspace  \textsc  {Disorder-NOX}\xspace  , where 9 of 52 predictors fall inside the band and 34 are significantly better.\relax }}{8}{table.caption.8}\protected@file@percent }
\newlabel{tab:c4}{{5}{8}{The claimed 10--15\% short-segment advantage of dedicated predictors is a calibration artefact. All deltas are percentage points of balanced accuracy on $<$20 aa regions relative to \plddt ; ``in band'' counts methods landing inside the claimed $+10$ to $+15$\pp window. Left: with every method at its own MCC-optimal threshold, no method is significantly better and the median is worse. Right: cutting every method at 0.5 --- the comparison one gets by thresholding published scores --- reproduces the claim almost exactly on \caidthree \dnox , where 9 of 52 predictors fall inside the band and 34 are significantly better.\relax }{table.caption.8}{}}
